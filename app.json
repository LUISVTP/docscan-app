{
  "expo": {
    "name": "DocScan",
    "slug": "docscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C86"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "DocScan necesita acceso a la camara para escanear documentos.",
        "NSPhotoLibraryUsageDescription": "DocScan necesita acceso a la galeria para seleccionar imagenes."
      }
    },
    "android": {
      "package": "com.docscan.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E7C86",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
